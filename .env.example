# Copy to .env and adjust. .env is git-ignored; this file is the template.

# Backend base URL (FastAPI), without /api. The dev server (devProxy) and a production build (server/backend-proxy.ts,
# read at runtime: set it in Vercel's environment variables) forward /api and /mock-eais here.
# The browser always calls same-origin /api, so the session cookie works; don't point the app at another origin directly.
API_BASE_URL=http://127.0.0.1:8000

# 1 = answer /api from the in-memory mock (server/mock) instead of the backend. Run `pnpm nuxt prepare` after switching back.
NUXT_PUBLIC_API_MOCK=

# 0 hides the demo-account chips on /login and the «Демо-данные» rail footer.
NUXT_PUBLIC_DEMO_ACCOUNTS=1
